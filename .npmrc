# Defensa de cadena de suministro (CONVENCIONES §1.1). npm no hereda config de
# directorios padre: por eso el archivo vive en el repo y viaja también a CI.
# No ejecutar lifecycle scripts de dependencias: vector #1 de inyección.
ignore-scripts=true
# Versiones EXACTAS (sin ^ ni ~): cada bump es un cambio explícito y auditable.
save-exact=true
fund=false
