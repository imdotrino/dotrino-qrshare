{
  "name": "QRShare — Dotrino",
  "short_name": "QRShare",
  "description": "Transferencia de archivos directa entre dispositivos, sin pasar por un servidor. Comparte por QR.",
  "start_url": "./",
  "scope": "./",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#e5e7eb",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
